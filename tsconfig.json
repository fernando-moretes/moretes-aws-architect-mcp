{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "outDir": "dist", "rootDir": "src", "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "declaration": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
