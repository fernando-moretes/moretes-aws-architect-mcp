{
  "name": "moretes-aws-architect-mcp",
  "version": "0.4.1",
  "description": "Evidence-first architecture workbench MCP by Fernando Azevedo: architect personas, cloud-agnostic design tools, IaC/code/API reviews, AI-agent and MCP safety, live AWS knowledge. Deterministic, no model calls. CLI for pipelines.",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.fernando-moretes/moretes-aws-architect-mcp",
  "homepage": "https://fernando.moretes.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernando-moretes/moretes-aws-architect-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/fernando-moretes/moretes-aws-architect-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "architecture",
    "aws",
    "azure",
    "gcp",
    "well-architected",
    "adr",
    "terraform",
    "kubernetes",
    "finops",
    "ai-agents",
    "security",
    "solution-architect"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "moretes-architect": "dist/cli.js",
    "moretes-aws-architect-mcp": "dist/stdio.js"
  },
  "files": [
    ".claude-plugin",
    ".pre-commit-hooks.yaml",
    "LICENSE",
    "NOTICE.md",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "action.yml",
    "dist",
    "gemini-extension.json",
    "scripts/prepare.mjs",
    "scripts/action-review.mjs",
    "server.json",
    "skills",
    "src/data",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/stdio.js",
    "dev": "tsx src/stdio.ts",
    "http": "tsx src/http.ts",
    "smoke": "tsx scripts/smoke.ts",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "cli": "node dist/cli.js",
    "prepare": "node scripts/prepare.mjs",
    "docs:tools": "node scripts/tool-docs.mjs",
    "coverage": "tsx --test --experimental-test-coverage test/*.test.ts",
    "contracts": "node scripts/contracts.mjs",
    "examples": "node scripts/examples.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cost-explorer": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
